{
  "name": "debate-ai",
  "private": true,
  "version": "2.2.0",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "!packages/debate-editor-cm",
    "!packages/debate-rankings-sync-data",
    "!packages/debate-tournaments-tabroom",
    "apps/*"
  ],
  "scripts": {
    "up": "git submodule update --remote --recursive",
    "merge": "bash .github/scripts/merge.sh",
    "dev": "turbo dev",
    "build": "turbo build --filter='!@debate-ai/help-docs' --filter='!@debate-ai/flow-ebb'",
    "dev:web": "turbo dev --filter=@debate-ai/web",
    "build:web": "turbo build --filter=@debate-ai/web",
    "dev:editor": "turbo dev --filter=reason-editor",
    "build:editor": "turbo build --filter=reason-editor",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config apps/debate-web/vitest.config.ts",
    "test:watch": "vitest --config apps/debate-web/vitest.config.ts",
    "coverage": "vitest run --coverage --config apps/debate-web/vitest.config.ts"
  },
  "devDependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "turbo": "^2.11.13",
    "vinext": "1.4.6",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "docx-preview": "^0.4.1",
    "grab-url": "^3.0.10",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "linkedom": "0.18.15",
    "react-reason-editor-sidebar": "^0.1.338"
  },
  "overrides": {
    "@ricky0123/vad-web": "^0.0.31",
    "@ai-sdk/provider": "^4.0.39",
    "@ai-sdk/openai": "4.0.123",
    "@ai-sdk/anthropic": "4.0.108",
    "@ai-sdk/provider-utils": "5.0.83",
    "@ai-sdk/amazon-bedrock": "5.0.147",
    "ai": "7.0.181",
    "@amplitude/session-replay-browser": "1.54.1",
    "balanced-match": "^4.0.4",
    "mdast-util-to-markdown": "2.2.3",
    "@posthog/core": "1.69.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "linkedom": "0.18.15",
    "vimeo-video-element": "1.7.5",
    "extract-cite": "1.0.162",
    "tailwindcss": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/node": "4.3.5"
  }
}
