{
  "name": "debate-ai",
  "private": true,
  "version": "2.2.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "!packages/debate-tournaments-tabroom",
    "!packages/debate-editor-cm",
    "!packages/debate-rankings",
    "!packages/debate-flow-ebb",
    "apps/debate-ai.com",
    "apps/debate-browser-ext"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --filter='!debate-help-docs' --filter='!debate-flow-ebb'",
    "dev:web": "turbo dev --filter=debate-ai-web",
    "build:web": "turbo build --filter=debate-ai-web",
    "dev:editor": "turbo dev --filter=reason-editor",
    "build:editor": "turbo build --filter=reason-editor",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config apps/debate-ai.com/vitest.config.ts",
    "test:watch": "vitest --config apps/debate-ai.com/vitest.config.ts",
    "coverage": "vitest run --coverage --config apps/debate-ai.com/vitest.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "turbo": "^2.11.6",
    "vinext": "1.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "docx-preview": "^0.4.1",
    "grab-url": "^3.0.6",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "react-reason-editor-sidebar": "^0.1.156"
  },
  "overrides": {
    "@ricky0123/vad-web": "^0.0.30",
    "@ai-sdk/provider": "^4.0.0",
    "balanced-match": "^4.0.2",
    "mdast-util-to-markdown": "2.1.2"
  }
}
