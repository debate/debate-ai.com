{
  "name": "debate-ai",
  "private": true,
  "version": "2.2.0",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/debate-ai.com"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --filter='!debate-help-docs'",
    "dev:web": "turbo dev --filter=debate-ai-web",
    "build:web": "turbo build --filter=debate-ai-web",
    "dev:editor": "turbo dev --filter=reason-editor",
    "build:editor": "turbo build --filter=reason-editor",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config apps/debate-ai.com/vitest.config.ts",
    "test:watch": "vitest --config apps/debate-ai.com/vitest.config.ts",
    "coverage": "vitest run --coverage --config apps/debate-ai.com/vitest.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "turbo": "^2.10.12",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "docx-preview": "^0.4.0",
    "grab-url": "^1.6.22",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13"
  },
  "overrides": {
    "@ricky0123/vad-web": "^0.0.30"
  }
}
