{
  "name": "debate-ai",
  "private": true,
  "version": "2.2.0",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "!packages/debate-editor-cm",
    "!packages/debate-rankings-sync-data",
    "!packages/debate-tournaments-tabroom",
    "apps/*"
  ],
  "scripts": {
    "up": "git submodule update --remote --recursive",
    "merge": "bash .github/scripts/merge.sh",
    "dev": "turbo dev",
    "build": "turbo build --filter='!@debate-ai/help-docs' --filter='!@debate-ai/flow-ebb'",
    "dev:web": "turbo dev --filter=@debate-ai/ai-web",
    "build:web": "turbo build --filter=@debate-ai/ai-web",
    "dev:editor": "turbo dev --filter=reason-editor",
    "build:editor": "turbo build --filter=reason-editor",
    "typecheck": "turbo typecheck",
    "test": "vitest run --config apps/debate-web/vitest.config.ts",
    "test:watch": "vitest --config apps/debate-web/vitest.config.ts",
    "coverage": "vitest run --coverage --config apps/debate-web/vitest.config.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "turbo": "^2.11.10",
    "vinext": "1.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "docx-preview": "^0.4.1",
    "grab-url": "^3.0.7",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "linkedom": "0.18.13",
    "react-reason-editor-sidebar": "^0.1.268"
  },
  "overrides": {
    "@ricky0123/vad-web": "^0.0.30",
    "@ai-sdk/provider": "^4.0.0",
    "balanced-match": "^4.0.2",
    "mdast-util-to-markdown": "2.1.2",
    "@posthog/core": "1.57.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "linkedom": "0.18.13"
  }
}
