{
  "name": "@debate-ai/videos",
  "version": "0.1.0",
  "description": "Debate video library — grids, search, the persistent YouTube player, lecture pages and rankings leaderboards",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-videos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-videos"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "./src/*/*": [
      "./src/*/*",
      "./src/*/*/*.ts",
      "./src/*/*/*.tsx",
      "./src/*/*/index.ts"
    ],
    "./src/*/*/*": [
      "./src/*/*/*",
      "./src/*/*/*/*.ts",
      "./src/*/*/*/*.tsx",
      "./src/*/*/*/index.ts"
    ],
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "./*/*": [
      "./src/*/*",
      "./src/*/*/*.ts",
      "./src/*/*/*.tsx",
      "./src/*/*/index.ts"
    ],
    "./*/*/*": [
      "./src/*/*/*",
      "./src/*/*/*/*.ts",
      "./src/*/*/*/*.tsx",
      "./src/*/*/*/index.ts"
    ],
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "migrations",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@debate-ai/comments": "workspace:*",
    "@debate-ai/predictions": "workspace:*",
    "@debate-ai/rankings-adapter": "workspace:*",
    "@debate-ai/research-evidence": "workspace:*",
    "@debate-ai/timer": "workspace:*",
    "@debate-ai/types": "workspace:*",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "grab-url": "^3.0.7",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "motion": "^14.5.0",
    "mpg123-decoder": "1.0.3",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15",
    "@debate-ai/icons": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "next": "16.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
