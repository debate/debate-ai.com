{
  "name": "@debate/research-evidence",
  "version": "0.1.0",
  "description": "Evidence card search UI and the community research-and-evidence layer — search interface, evidence/argument libraries, LLM card scoring, revision incentives, review queue and topic coverage",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "main": "./src/index.ts",
  "sideEffects": ["**/*.css"],
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "upload:cards": "bun run src/cli/upload-parquet.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@debate/card-parser": "workspace:*",
    "@debate/comments": "workspace:*",
    "dompurify": "^3.4.16",
    "fuse.js": "^7.5.0",
    "grab-url": "^1.6.22",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "lucide-react": "^1.49.0",
    "prismjs": "^1.30.0",
    "qwksearch-api-client": "^1.0.109",
    "react-native-app-buttons": "^0.1.4",
    "react-resizable-panels": "^4.14.1",
    "research-agent-ui": "^0.1.293",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "hyparquet-writer": "^0.16.10",
    "next": "16.3.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "debate-cards-upload": "./src/cli/upload-parquet.ts"
