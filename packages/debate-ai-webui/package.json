{
  "name": "debate-ai-webui",
  "version": "0.1.0",
  "description": "The whole debate-ai.com frontend as a React package — the app shell, every route, and the components and tools behind them — mountable in Next.js or, through its next/* shims, in any React host such as the browser extension",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./app.css": "./src/styles/app.css",
    "./next/*": "./src/next/*.tsx",
    "./*": "./src/*",
    "./package.json": "./package.json",
    "./dist/app.css": "./dist/app.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:css": "tailwindcss -i src/styles/app.css -o dist/app.css --minify"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-auth": "^1.7.3",
    "chat-agent-toolkit": "^1.2.283",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "compute-cosine-similarity": "^1.1.0",
    "debate-api-client": "workspace:*",
    "debate-community": "workspace:*",
    "debate-data-sync": "workspace:*",
    "debate-editor": "workspace:*",
    "debate-feature-catalog": "workspace:*",
    "debate-practice-rounds": "workspace:*",
    "debate-practice-vs-ai": "workspace:*",
    "debate-research-evidence": "workspace:*",
    "debate-round": "workspace:*",
    "debate-speech-writer": "workspace:*",
    "debate-team-collaboration": "workspace:*",
    "debate-tournaments": "workspace:*",
    "debate-videos": "workspace:*",
    "easydrawer": "^0.0.18",
    "framer-motion": "^13.2.0",
    "fuse.js": "^7.5.0",
    "grab-url": "^1.6.22",
    "katex": "0.18.7",
    "legal-terms-privacy-policy": "^0.1.0",
    "lucide-react": "^1.43.0",
    "mixpanel-browser": "^2.83.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "qwksearch-api-client": "^1.0.24",
    "react-icons": "^5.7.0",
    "react-reason-editor": "^1.0.85",
    "react-reason-editor-sidebar": "^0.1.5",
    "research-agent-ui": "^0.1.152",
    "shadcn-settings": "^0.1.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "write-language": "^0.1.153",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
