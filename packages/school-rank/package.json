{
  "name": "@debate-ai/school-rank",
  "version": "0.1.0",
  "description": "Top US colleges and public and private high schools with their U.S. News (and, for high schools, Niche) ranks, Fuse.js fuzzy search with a college / high-school filter, and the school wordmark logos under ./wordmarks",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/school-rank#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/school-rank"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wordmarks": "./src/wordmark-assets.ts",
    "./wordmarks/*": "./wordmarks/*",
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "data",
    "wordmarks"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@debate-ai/rankings": "workspace:*",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
