{
  "name": "@debate/comments",
  "version": "0.1.0",
  "description": "Threaded comments — the YouTube/Instagram-style discussion UI (replies, nested reply trees, likes) for any commentable resource in debate-ai",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/preserve",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-comments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-comments"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
