{
  "name": "@debate-ai/rankings",
  "version": "0.1.0",
  "description": "Adapter over the debate-rankings-sync-data git submodule (github.com/debate/debate-rankings) for the web UI: the typed dataset list and CSV loader over its Bradley-Terry ranking CSVs, the site's rating scale and the team-label lookup, plus the rankings UI (leaderboard, team and school profiles, matchup simulator, team labels) under ./leaderboard",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-rankings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-rankings"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./leaderboard": "./src/leaderboard/index.ts",
    "./src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "./src/*/*": [
      "./src/*/*",
      "./src/*/*/*.ts",
      "./src/*/*/*.tsx",
      "./src/*/*/index.ts"
    ],
    "./src/*/*/*": [
      "./src/*/*/*",
      "./src/*/*/*/*.ts",
      "./src/*/*/*/*.tsx",
      "./src/*/*/*/index.ts"
    ],
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@debate-ai/data-sync": "workspace:*",
    "@debate-ai/types": "workspace:*",
    "@debate-ai/ui": "workspace:*",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grab-url": "^3.0.7",
    "lucide-react": "^1.61.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
