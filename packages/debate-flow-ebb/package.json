{
  "name": "debate-flow-ebb",
  "version": "0.1.0",
  "description": "ebb, the local-first keyboard-first flow editor, ported in as a workspace package. EbbFlowEmbed mounts it as one column of a host page (debate-round's live round editor) rather than the page-owning app it is standalone.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "main": "./src/EbbFlowEmbed.tsx",
  "types": "./src/EbbFlowEmbed.tsx",
  "exports": {
    ".": "./src/EbbFlowEmbed.tsx",
    "./settings-panel": "./src/components/settings/EmbeddedSettingsPanel.tsx",
    "./quick-actions": "./src/lib/start/quickActions.ts",
    "./store": "./src/lib/store/useFlowStore.ts",
    "./tooltip": "./src/components/ui/tooltip.tsx",
    "./styles/ebb-scope.css": "./src/styles/ebb-scope.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fsegurai/codemirror-theme-github-dark": "^6.2.5",
    "@fsegurai/codemirror-theme-github-light": "^6.2.5",
    "@handsontable/react-wrapper": "^18.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@replit/codemirror-vim": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "handsontable": "^18.0.0",
    "marked": "^18.0.9",
    "motion": "^13.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
