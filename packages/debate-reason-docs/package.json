{
  "name": "@debate-ai/reason-docs",
  "version": "0.1.0",
  "description": "The REASON docs workspace — the file-manager tree and tabs in the sidebar, the editor screen, sharing and selling a file, Topic Starters, and the stored-card format helpers behind them",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-reason-docs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-reason-docs"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts"
    ],
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@debate-ai/card-parser": "workspace:*",
    "@debate-ai/editor": "workspace:*",
    "@debate-ai/file-market": "workspace:*",
    "@debate-ai/rankings": "workspace:*",
    "@debate-ai/team-collaboration": "workspace:*",
    "@debate-ai/types": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@svar-ui/react-filemanager": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@debate-ai/videos": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
