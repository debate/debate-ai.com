{
  "name": "@debate/tournaments",
  "version": "0.1.0",
  "description": "Tournament tabulation, invites, pairings, results and judge paradigms — upstream Tabroom (debate/debate-tournament-tabroom) vendored and adapted to Cloudflare Workers + D1, exporting its API handler, React UI and route table",
  "type": "module",
  "author": "vtempest",
  "license": "RPL-1.5",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-tournaments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-tournaments"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./ui": "./src/ui/index.ts",
    "./client": "./src/ui/client.ts",
    "./routes": "./src/routes/index.ts",
    "./types": "./src/types.ts",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "src",
    "migrations",
    "seed",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "sync-upstream:latest": "node scripts/sync-upstream.mjs --latest",
    "seed:demo": "node scripts/generate-demo-seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "lucide-react": "^1.49.0",
    "luxon": "^3.7.2",
    "router": "^2.2.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5",
    "@debate/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
