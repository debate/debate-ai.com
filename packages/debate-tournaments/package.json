{
  "name": "debate-tournaments",
  "version": "0.1.0",
  "description": "Tournament tabulation, invites, pairings, results and judge paradigms — upstream Tabroom (debate/debate-tournament-tabroom) vendored and adapted to Cloudflare Workers + D1, exporting its API handler, React UI and route table",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "RPL-1.5",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./ui": "./src/ui/index.ts",
    "./routes": "./src/routes/index.ts",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "sync-upstream:latest": "node scripts/sync-upstream.mjs --latest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "kysely": "^0.29.5",
    "lucide-react": "^1.43.0",
    "luxon": "^3.7.2",
    "router": "^2.2.0",
    "sanitize-html": "^2.17.4",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
