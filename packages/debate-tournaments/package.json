{
  "name": "@debate-ai/tournaments",
  "version": "0.1.0",
  "description": "Tournament tabulation, invites, pairings, results and judge paradigms — upstream Tabroom (debate/debate-tournament-tabroom) vendored and adapted to Cloudflare Workers + D1, exporting its API handler, React UI and route table",
  "type": "module",
  "author": "vtempest",
  "license": "RPL-1.5",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-tournaments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-tournaments"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./ui": "./src/ui/index.ts",
    "./client": "./src/ui/client.ts",
    "./routes": "./src/routes/index.ts",
    "./types": "./src/types.ts",
    "./ballots": "./src/ballots.ts",
    "./sidebar": "./src/sidebar.ts",
    "./paradigms": "./src/paradigms.ts",
    "./judge-paradigms/*": "./src/judge-paradigms/*.ts",
    "./paradigm-editor": "./src/ui/paradigm/JudgeParadigmEditor.tsx",
    "./majors": "./src/ui/majors/index.ts",
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "src",
    "migrations",
    "seed",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "sync-upstream:latest": "node scripts/sync-upstream.mjs --latest",
    "seed:demo": "node scripts/generate-demo-seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@debate-ai/types": "workspace:*",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-text": "^10.0.1",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "luxon": "^3.7.2",
    "marked": "^18.1.1",
    "radix-ui": "^1.8.1",
    "router": "^2.2.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
