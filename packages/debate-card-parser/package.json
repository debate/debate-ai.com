{
  "name": "@debate/card-parser",
  "version": "0.1.0",
  "description": "Parser for debate evidence cards — Verbatim .docx and HTML in, structured cards with citations and highlighting out",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-card-parser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-card-parser"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
