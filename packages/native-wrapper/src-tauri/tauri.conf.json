{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Debate AI",
  "version": "1.0.0",
  "identifier": "com.debateai.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Debate AI",
        "url": "https://debate-ai.com",
        "width": 1360,
        "height": 860,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Debate AI",
    "copyright": "Debate AI",
    "category": "Education",
    "shortDescription": "CARDS evidence search, FIAT round flowing, REASON writing, and LEARN video library, in one native app.",
    "longDescription": "CARDS evidence search, FIAT round flowing, REASON writing, and LEARN video library, in one native app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "debateai"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "debateai"
          ],
          "appLink": false
        }
      ]
    },
    "updater": {
      "active": false
    }
  }
}
