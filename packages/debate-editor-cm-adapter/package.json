{
  "name": "debate-editor-cm-adapter",
  "version": "0.1.0",
  "description": "Adapter over the debate-editor git submodule (github.com/debate/debate-editor, CardMirror) for the web UI: its ProseMirror schema and lossless Verbatim .docx / .cmir interop, plus outline and card helpers",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "SEE LICENSE IN ../debate-editor-cm/LICENSE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "node scripts/link-upstream-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
