{
  "name": "@debate-ai/ui",
  "version": "0.1.0",
  "description": "Shared shadcn/Radix UI primitives, the `cn` class merger, the mobile breakpoint hook and the panel building blocks every debate-ai package renders with",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-ui"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "sideEffects": false,
  "exports": {
    "./primitives/*": "./src/primitives/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./hooks/use-mobile": "./src/hooks/use-mobile.ts",
    "./panels/panel-shell": "./src/panels/panel-shell.tsx",
    "./panels/use-store-snapshot": "./src/panels/use-store-snapshot.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
