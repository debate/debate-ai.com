{
  "name": "@debate-ai/webview",
  "version": "0.1.0",
  "description": "The whole debate-ai.com frontend as a React package — the app shell, every route, and the components and tools behind them — mountable in Next.js or, through its next/* shims, in any React host such as the browser extension",
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-webview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-webview"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "main": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app.css": "./src/styles/app.css",
    "./next/*": "./src/next/*.tsx",
    "./*": "./src/*",
    "./package.json": "./package.json",
    "./dist/app.css": "./dist/app.css"
  },
  "files": [
    "src",
    "dist",
    "components.json",
    "migrations",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:css": "tailwindcss -i src/styles/app.css -o dist/app.css --minify"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
