{
  "name": "debate-settings",
  "version": "0.1.0",
  "description": "Central account-settings package for apps/debate-ai.com's /settings page — composes the CardMirror editor's and the ebb flow editor's own settings UIs (each still implemented in its own package) into panels and isolated same-origin iframe routes /settings can embed.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "debate-editor": "workspace:*",
    "debate-flow-ebb": "workspace:*",
    "lucide-react": "^0.577.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "16.1.6",
    "typescript": "^5.9.3"
  }
}
