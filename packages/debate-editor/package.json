{
  "name": "debate-editor",
  "version": "0.1.0",
  "description": "Debate speech-doc editor: the app-facing shell over the reason-editor CardMirror engine plus the read-only markdown renderer",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
