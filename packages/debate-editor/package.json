  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "next": "16.1.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
