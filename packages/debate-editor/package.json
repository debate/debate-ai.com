{
  "name": "debate-editor",
  "version": "0.1.0",
  "description": "CardMirror-based debate-card editor, embedded in debate-ai.com — a ProseMirror engine (Verbatim .docx interop) plus a React shell sized for small embedded panels (Flow speech docs, the /reason-editor route).",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./src/react/index.tsx",
  "types": "./src/react/index.tsx",
  "exports": {
    ".": "./src/react/index.tsx",
    "./engine": "./src/index.ts",
    "./styles.css": "./src/editor/style.css",
    "./settings": "./src/editor/settings.ts",
    "./settings-ui": "./src/editor/settings-ui.ts",
    "./settings-categories": "./src/editor/settings-categories.ts",
    "./collab-bridge": "./src/react/collab-bridge.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debate-card-parser": "workspace:*",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "loro-crdt": "1.16.0",
    "loro-prosemirror": "0.4.4",
    "lucide-react": "^1.43.0",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3",
    "tailwind-merge": "^3.6.0",
    "tinyld": "^1.3.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
