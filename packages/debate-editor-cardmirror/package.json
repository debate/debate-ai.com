{
  "name": "debate-editor-cardmirror",
  "version": "0.1.0",
  "description": "CardMirror-based debate-card editor, embedded in debate-ai.com — a ProseMirror engine (Verbatim .docx interop) plus a React shell sized for small embedded panels (Flow speech docs, the /reason-editor route).",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./src/react/index.tsx",
  "types": "./src/react/index.tsx",
  "exports": {
    ".": "./src/react/index.tsx",
    "./engine": "./src/index.ts",
    "./styles.css": "./src/editor/style.css",
    "./settings": "./src/editor/settings.ts",
    "./settings-ui": "./src/editor/settings-ui.ts",
    "./settings-categories": "./src/editor/settings-categories.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "debate-ui": "workspace:*",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.3",
    "loro-crdt": "1.13.6",
    "loro-prosemirror": "0.4.3",
    "lucide-react": "^0.577.0",
    "nspell": "^2.1.5",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.0",
    "tinyld": "^1.3.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
