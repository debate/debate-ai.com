{
  "name": "debateai-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./src/lib/cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply debateai --local",
    "db:migrate:remote": "wrangler d1 migrations apply debateai --remote",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
