{
  "name": "debate-practice-vs-ai",
  "version": "0.1.0",
  "description": "Practice vs AI — a full timed debate round against an AI opponent. Node/TypeScript port of the Go `arguehub` vs-bot backend (bot personalities, prompt construction, AI judging, gamification) plus the React round UI.",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./client": "./src/client/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debate-speech-writer": "workspace:*",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "next": "16.1.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
