{
  "name": "@debate/practice-vs-ai",
  "version": "0.1.0",
  "description": "Practice vs AI — a full timed debate round against an AI opponent. Node/TypeScript port of the Go `arguehub` vs-bot backend (bot personalities, prompt construction, AI judging, gamification) plus the React round UI.",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "main": "./src/index.ts",
  "sideEffects": ["**/*.css"],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./client": "./src/client/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@debate/speech-writer": "workspace:*",
    "lucide-react": "^1.49.0",
    "tailwind-merge": "^3.7.0",
    "@types/debate": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "next": ">=15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "next": "16.3.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
