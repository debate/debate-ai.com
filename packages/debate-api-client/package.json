{
  "name": "debate-api-client",
  "version": "0.1.0",
  "description": "Typed SDK for the Debate AI API, generated from debate-openapi.yml with Hey API and powered by grab-url (caching, retries, rate limiting, and dedupe on every call).",
  "private": false,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-api-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-api-client"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "keywords": [
    "debate-ai",
    "openapi",
    "sdk",
    "api-client",
    "hey-api",
    "grab-url"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "grab-url": "^1.6.22"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
