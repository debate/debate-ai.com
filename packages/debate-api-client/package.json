{
  "name": "@debate-ai/api-client",
  "version": "0.1.0",
  "description": "Typed SDK for the Debate AI API, generated from debate-openapi.yml with Hey API and powered by grab-url (caching, retries, rate limiting, and dedupe on every call).",
  "private": false,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-api-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-api-client"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "keywords": [
    "debate-ai",
    "openapi",
    "sdk",
    "api-client",
    "hey-api",
    "grab-url"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./debate-openapi.yml": "./debate-openapi.yml",
    "./package.json": "./package.json",
    "./mcp-tools.json": "./mcp-tools.json"
  },
  "files": [
    "dist",
    "debate-openapi.yml",
    "mcp-tools.json",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-ts",
    "generate:mcp": "bun scripts/generate-mcp-tools.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "grab-url": "^3.0.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "api2ai": "1.0.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
