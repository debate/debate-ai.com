{
  "name": "@debate/data-sync",
  "version": "0.1.0",
  "description": "Debate data assets (metadata, videos, schemas) plus sync scripts for YouTube videos, debate rankings and openCaselist bulk downloads",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "homepage": "https://github.com/debate/debate-ai.com/tree/master/packages/debate-data-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debate/debate-ai.com.git",
    "directory": "packages/debate-data-sync"
  },
  "bugs": {
    "url": "https://github.com/debate/debate-ai.com/issues"
  },
  "exports": {
    ".": "./package.json",
    "./data/metadata/*": "./data/*",
    "./data/debate-school-names": "./data/debate-school-names.ts",
    "./package.json": "./package.json",
    "./src/*.ts": "./src/*.ts",
    "./src/*.tsx": "./src/*.tsx",
    "./src/*": "./src/*.ts",
    "./*": "./*"
  },
  "files": [
    "src",
    "data",
    "migrations",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "coverage": "vitest run --coverage",
    "download-caselist": "bun run src/caselist/caselist-download-cli.ts",
    "extract-transcripts": "bun run src/youtube/extract-transcripts.ts",
    "grab-caselist": "bun run src/caselist/caselist-grab-cli.ts",
    "sync-caselist": "bun run src/caselist/caselist-sync-cli.ts",
    "sync-youtube": "bun run src/youtube/youtube-sync-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "youtube-stats": "bun run src/youtube/youtube-sync-cli.ts --stats",
    "youtube-update-views": "bun run src/youtube/youtube-sync-cli.ts --update-views"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@debate/card-parser": "workspace:*",
    "extract-youtube": "^1.0.425",
    "grab-url": "^1.6.22",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "@debate/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
