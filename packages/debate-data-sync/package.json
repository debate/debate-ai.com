{
  "name": "debate-data-sync",
  "version": "0.1.0",
  "description": "Debate data assets (metadata, videos, schemas) plus sync scripts for YouTube videos and debate rankings",
  "private": true,
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "scripts": {
    "coverage": "vitest run --coverage",
    "extract-transcripts": "bun run src/youtube/extract-transcripts.ts",
    "sync-youtube": "bun run src/youtube/youtube-sync-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "youtube-stats": "bun run src/youtube/youtube-sync-cli.ts --stats",
    "youtube-update-views": "bun run src/youtube/youtube-sync-cli.ts --update-views"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "extract-youtube": "^1.0.2",
    "grab-url": "^1.6.22",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
