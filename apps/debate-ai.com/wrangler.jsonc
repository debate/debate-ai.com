{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Cloudflare Workers Builds project name, otherwise CI
	// overrides it at deploy time and a manual `wrangler deploy` from this
	// directory targets a different Worker than production.
	"name": "debate-ai-com",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Without keep_vars, every `wrangler deploy` deletes plaintext Variables
	// entered in the CF dashboard (API keys, BETTER_AUTH_SECRET, …) because
	// this config defines no `vars`. Secrets survive either way.
	"keep_vars": true,
	// Ship source maps with the Worker so runtime exceptions in Workers Logs
	// resolve to real files/lines instead of minified bundle offsets. Source
	// maps are stored separately and do not count against the Worker size limit.
	"upload_source_maps": true,
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	// Weekly YouTube maintenance — Mondays at 08:00 UTC: scan the subscribed
	// channels for new videos, then refresh every stored video's view count.
	// Handled by the `scheduled` export in worker/index.ts.
	"triggers": {
		"crons": [
			"0 8 * * 1"
		]
	},
	"env": {
		"production": {
			"images": {
				"binding": "IMAGES"
			},
			"triggers": {
				"crons": [
					"0 8 * * 1"
				]
			},
			"d1_databases": [
				{
					"binding": "debate_db",
					"database_name": "debate-ai-db",
					"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
				}
			]
		}
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"d1_databases": [
		{
			"binding": "debate_db",
			"database_name": "debate-ai-db",
			"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
		}
	]
}