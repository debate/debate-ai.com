{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Cloudflare Workers Builds project name, otherwise CI
	// overrides it at deploy time and a manual `wrangler deploy` from this
	// directory targets a different Worker than production.
	"name": "debate-ai-com",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Without keep_vars, every `wrangler deploy` deletes plaintext Variables
	// entered in the CF dashboard (API keys, BETTER_AUTH_SECRET, …) that are
	// not listed in `vars` below. Secrets survive either way.
	"keep_vars": true,
	// The hardcoded admin. Kept to ADMIN_EMAIL so extra admins can still be
	// added via ADMIN_EMAILS in the dashboard — lib/auth/admin.ts merges both.
	// `vars` are not inherited by named environments, so env.production
	// repeats it.
	"vars": {
		"ADMIN_EMAIL": "grokthiscontact@gmail.com"
	},
	// Ship source maps with the Worker so runtime exceptions in Workers Logs
	// resolve to real files/lines instead of minified bundle offsets. Source
	// maps are stored separately and do not count against the Worker size limit.
	"upload_source_maps": true,
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	// Weekly YouTube maintenance — Mondays at 08:00 UTC: scan the subscribed
	// channels for new videos, then refresh every stored video's view count.
	// Weekly content backup to R2 — Sundays at 07:00 UTC (DB_BACKUP_CRON in
	// lib/admin/weekly-db-backup.ts; keep the two in sync).
	// Both handled by the `scheduled` export in worker/index.ts.
	"triggers": {
		"crons": [
			"0 8 * * 1",
			"0 7 * * 0"
		]
	},
	// SQL backups of the content tables (videos, cards, history — no user
	// data), written by /admin and the weekly cron. Private bucket; the admin
	// panel downloads through /api/admin/db-backup/file. Create it once with
	// `wrangler r2 bucket create debate-ai-db-backups`. Like `vars`,
	// `r2_buckets` is not inherited by named environments, so env.production
	// repeats it.
	"r2_buckets": [
		{
			"binding": "DB_BACKUPS",
			"bucket_name": "debate-ai-db-backups"
		}
	],
	// `.sql.7z` copies of those backups (one KV value each, 25 MiB max).
	// No `id`: wrangler provisions the namespace on the first deploy. Not
	// inherited by named environments either, so env.production repeats it.
	"kv_namespaces": [
		{
			"binding": "DB_BACKUPS_KV"
		}
	],
	// Webcam-room signalling (lib/webcam/debate-room.ts): one hibernating Durable
	// Object per room relays WebRTC offers/answers/ICE; media never touches it.
	// Like `vars`, `durable_objects` is not inherited by named environments,
	// so env.production repeats it.
	"durable_objects": {
		"bindings": [
			{
				"name": "DEBATE_ROOMS",
				"class_name": "DebateRoomSignal"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-debate-rooms",
			"new_sqlite_classes": [
				"DebateRoomSignal"
			]
		}
	],
	"env": {
		"production": {
			
			"images": {
				"binding": "IMAGES"
			},
			"triggers": {
				"crons": [
					"0 8 * * 1",
					"0 7 * * 0"
				]
			},
			"r2_buckets": [
				{
					"binding": "DB_BACKUPS",
					"bucket_name": "debate-ai-db-backups"
				}
			],
			"kv_namespaces": [
				{
					"binding": "DB_BACKUPS_KV"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "DEBATE_ROOMS",
						"class_name": "DebateRoomSignal"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1-debate-rooms",
					"new_sqlite_classes": [
						"DebateRoomSignal"
					]
				}
			],
			"d1_databases": [
				{
					"binding": "debate_db",
					"database_name": "debate-ai-db",
					"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
				}
			]
		}
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"d1_databases": [
		{
			"binding": "debate_db",
			"database_name": "debate-ai-db",
			"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
		}
	]
}