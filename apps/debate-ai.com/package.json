{
  "name": "debate-ai-web",
  "description": "Debate AI enables competitive debaters in PF, LD & Policy to streamline AI research management, live speech sharing, and evidence analysis",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build:docs && vinext build && npm run build:sw",
    "build:docs": "node scripts/build-docs.mjs",
    "build:sw": "node lib/offline-sw/generate.cjs && webpack --config webpack.config.cjs && cp public/service-worker.js dist/client/service-worker.js",
    "start": "vinext start",
    "deploy": "npm run db:migrate:d1 && npm run build && vinext deploy --skip-build",
    "deploy:upload": "node scripts/deploy-upload.mjs",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' vinext build && npm run build:sw && wrangler dev",
    "deploy:staging": "npm run build && vinext deploy --skip-build --env staging",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:d1": "drizzle-kit push --config drizzle.d1.config.ts",
    "db:migrate:d1": "bun run scripts/migrate-d1.ts",
    "db:seed:videos": "bun run scripts/seed-videos.ts",
    "db:seed:videos:d1": "bun run scripts/seed-videos.ts --sql-only && wrangler d1 execute debate-ai-db --remote --file=drizzle/seed/videos-seed.sql",
    "db:studio": "drizzle-kit studio",
    "favicon": "bun create favicon public/favicon-512.png public/ --overwrite",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
