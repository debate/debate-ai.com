{
  "name": "debate-web-ext",
  "description": "Debate-AI.com extension: the full debate-ai.com app on its Options page, plus a round timer, an article reader panel and a card reuse check.",
  "version": "6.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 wxt build",
    "build:firefox": "NODE_OPTIONS=--max-old-space-size=8192 wxt build -b firefox",
    "zip": "NODE_OPTIONS=--max-old-space-size=8192 wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "icons": "./scripts/resize-icons.sh",
    "build:app-css": "bun node_modules/@tailwindcss/cli/dist/index.mjs -i src/styles/options-app.css -o public/debate-ai-app.css --minify",
    "predev": "bun run build:app-css",
    "predev:firefox": "bun run build:app-css",
    "prebuild": "bun run build:app-css",
    "prebuild:firefox": "bun run build:app-css",
    "prezip": "bun run build:app-css"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "debate-webview": "workspace:*",
    "lucide-react": "^0.454.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0",
    "wxt": "^0.19.13"
  },
  "overrides": {
    "@vitejs/plugin-react": "^5.2.0"
  }
}