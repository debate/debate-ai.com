{
  "name": "@debate/web-ext",
  "description": "Read any page in an AI article panel, time a round, and check whether a card has already been cut from the page.",
  "version": "6.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 wxt build",
    "build:firefox": "NODE_OPTIONS=--max-old-space-size=8192 wxt build -b firefox",
    "zip": "NODE_OPTIONS=--max-old-space-size=8192 wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "icons": "./scripts/resize-icons.sh",
    "build:app-css": "bun node_modules/@tailwindcss/cli/dist/index.mjs -i src/styles/options-app.css -o public/debate-ai-app.css --minify",
    "predev": "bun run build:app-css",
    "predev:firefox": "bun run build:app-css",
    "prebuild": "bun run build:app-css",
    "prebuild:firefox": "bun run build:app-css",
    "prezip": "bun run build:app-css"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@debate/webview": "workspace:*",
    "jspdf": "2.5.2",
    "lucide-react": "^0.454.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "wxt": "^0.19.13"
  },
  "overrides": {
    "@vitejs/plugin-react": "^5.2.0"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  }
}