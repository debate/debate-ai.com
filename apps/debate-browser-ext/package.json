{
  "name": "@debate-ai/web-ext",
  "description": "Read any page in an AI article panel, time a round, and check whether a card has already been cut from the page.",
  "version": "6.3.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 wxt build",
    "build:firefox": "NODE_OPTIONS=--max-old-space-size=8192 wxt build -b firefox",
    "zip": "NODE_OPTIONS=--max-old-space-size=8192 wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "icons": "./scripts/resize-icons.sh",
    "build:app-css": "bun node_modules/@tailwindcss/cli/dist/index.mjs -i src/styles/options-app.css -o public/debate-ai-app.css --minify",
    "predev": "bun run build:app-css",
    "predev:firefox": "bun run build:app-css",
    "prebuild": "bun run build:app-css",
    "prebuild:firefox": "bun run build:app-css",
    "prezip": "bun run build:app-css"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@debate-ai/qwksearch": "workspace:*",
    "@debate-ai/timer": "workspace:*",
    "@debate-ai/webview": "workspace:*",
    "jspdf": "4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "@vitejs/plugin-react": "^6.1.2"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  }
}
