{
  "name": "@debate-ai/web",
  "description": "Debate AI enables competitive debaters in PF, LD & Policy to streamline AI research management, live speech sharing, and evidence analysis",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "scripts": {
    "dev": "vinext dev",
    "build": "node ../../.github/scripts/ensure-submodules.mjs && vinext build && bun run build:sw",
    "build:sw": "node lib/offline-sw/generate.cjs && bun build lib/offline-sw/service-worker.ts --outfile app/service-worker.js --target browser --minify && cp app/service-worker.js dist/client/service-worker.js",
    "offline:gen": "bun run build:sw",
    "start": "vinext start",
    "deploy": "npm run db:migrate:d1 && npm run build && npx @vinext/cloudflare deploy --skip-build",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' vinext build  && wrangler dev",
    "deploy:staging": "npm run build && vinext deploy --skip-build --env staging",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:d1": "DRIZZLE_TARGET=d1 drizzle-kit push",
    "db:migrate:d1": "bun run ../../.github/scripts/migrate-d1.ts",
    "db:seed:videos": "bun run ../../.github/scripts/seed-videos.ts",
    "db:seed:videos:d1": "bun run ../../.github/scripts/seed-videos.ts --sql-only && wrangler d1 execute debate-ai-db --remote --file=drizzle/seed/videos-seed.sql",
    "db:studio": "drizzle-kit studio",
    "favicon": "bun create favicon public/favicon-512.png public/ --overwrite",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
