{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Cloudflare Workers Builds project name, otherwise CI
	// overrides it at deploy time and a manual `wrangler deploy` from this
	// directory targets a different Worker than production.
// apps/debate-web/wrangler.jsonc
	"name": "d-ebate-app",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Without keep_vars, every `wrangler deploy` deletes plaintext Variables
	// entered in the CF dashboard (API keys, BETTER_AUTH_SECRET, …) that are
	// not listed in `vars` below. Secrets survive either way.
	"keep_vars": true,
	// The hardcoded admin. Kept to ADMIN_EMAIL so extra admins can still be
	// added via ADMIN_EMAILS in the dashboard — lib/auth/admin.ts merges both.
	// `vars` are not inherited by named environments, so env.production
	// repeats it.
	//
	// CANONICAL_SITE_URL is left empty on purpose: it is the canonical origin
	// for SEO metadata (/sitemap.xml's <loc>, the robots.txt `Sitemap:` line,
	// and every page's metadataBase), and an empty value falls through to
	// CANONICAL_HOST — d.ebate.app, the host the canonical-host redirect
	// consolidates to. Set it (full origin or bare host) to point a preview or
	// staging deployment at its own domain instead. See lib/seo/site-url.ts.
	"vars": {
		"ADMIN_EMAIL": "grokthiscontact@gmail.com",
		"CANONICAL_SITE_URL": ""
	},
	// A content-table backup is the one genuinely CPU-heavy thing this Worker
	// does: it reads every row of ~15 tables and DEFLATE-compresses the dump in
	// a single invocation, which outgrew the 30s default and failed with
	// `outcome: "exceededCpu"` (see lib/admin/deflate.ts for why the dump is
	// only compressed once). 120s leaves room for the dump to keep growing.
	// Standard usage model only; `env.production` repeats it.
	"limits": {
		"cpu_ms": 120000
	},
	// Ship source maps with the Worker so runtime exceptions in Workers Logs
	// resolve to real files/lines instead of minified bundle offsets. Source
	// maps are stored separately and do not count against the Worker size limit.
	"upload_source_maps": true,
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	
	// SQL backups of the content tables (videos, cards, history — no user
	// data), written by /admin and the weekly cron. Private bucket; the admin
	// panel downloads through /api/admin/db-backup/file. Create it once with
	// `wrangler r2 bucket create debate-ai-db-backups`. Like `vars`,
	// `r2_buckets` is not inherited by named environments, so env.production
	// repeats it.
	//
	// ROUND_RECORDINGS holds joined round recordings — every speech of a round
	// in one MP3, its captions, each debater's webcam clips and a manifest —
	// saved from the recording menu's "Join round recording" dialog
	// (lib/round-recordings/storage.ts). Private: files stream back only to
	// the account that uploaded them, through /api/round-recordings/file.
	// Create it once with `wrangler r2 bucket create debate-ai-round-recordings`.
	//
	// SPEECH_AUDIO holds each round's per-speech MP3 clips, cut in an editor's
	// browser by the transcript dialog's "Split speeches from audio" button
	// (lib/videos/speech-audio-store.ts). The bucket is named explicitly:
	// left unnamed, wrangler auto-provisions `<worker>-speech-audio`, and the
	// d-ebate-app-dev-test Workers Build failed re-creating a bucket that
	// already existed. Every Worker built from this file uses the production
	// D1 database, so it shares this bucket too, like the two above; the clip
	// keys D1 points at only resolve against one bucket.
	//
	// CARD_TEXT holds each imported debate card's full text and markup as
	// `cards/<id>.json` (lib/search/card-text-store.ts); D1 keeps only the
	// card's metadata and highlighted text. Named explicitly for the same
	// reason as SPEECH_AUDIO. Create it once with
	// `wrangler r2 bucket create debate-ai-card-text`.
	"r2_buckets": [
		{
			"binding": "DB_BACKUPS",
			"bucket_name": "debate-ai-db-backups"
		},
		{
			"binding": "ROUND_RECORDINGS",
			"bucket_name": "debate-ai-round-recordings"
		},
		{
			"binding": "SPEECH_AUDIO",
			"bucket_name": "debate-ai-com-speech-audio"
		},
		{
			"binding": "CARD_TEXT",
			"bucket_name": "debate-ai-card-text"
		}
	],
	// `.sql.7z` copies of those backups (one KV value each, 25 MiB max).
	// No `id`: wrangler provisions the namespace on the first deploy. Not
	// inherited by named environments either, so env.production repeats it.
	"kv_namespaces": [
		{
			"binding": "DB_BACKUPS_KV"
		}
	],
	// Webcam-room signalling (lib/webcam/debate-room.ts): one hibernating Durable
	// Object per room relays WebRTC offers/answers/ICE; media never touches it.
	// Like `vars`, `durable_objects` is not inherited by named environments,
	// so env.production repeats it.
	"durable_objects": {
		"bindings": [
			{
				"name": "DEBATE_ROOMS",
				"class_name": "DebateRoomSignal"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-debate-rooms",
			"new_sqlite_classes": [
				"DebateRoomSignal"
			]
		}
	],
	"env": {
		"production": {
			"limits": {
				"cpu_ms": 120000
			},
			"images": {
				"binding": "IMAGES"
			},
			"triggers": {
				"crons": [
					"0 6 * * *",
					"0 8 * * MON",
					"0 7 * * SUN"
				]
			},
			"r2_buckets": [
				{
					"binding": "DB_BACKUPS",
					"bucket_name": "debate-ai-db-backups"
				},
				{
					"binding": "ROUND_RECORDINGS",
					"bucket_name": "debate-ai-round-recordings"
				},
				{
					"binding": "SPEECH_AUDIO",
					"bucket_name": "debate-ai-com-speech-audio"
				},
				{
					"binding": "CARD_TEXT",
					"bucket_name": "debate-ai-card-text"
				}
			],
			"kv_namespaces": [
				{
					"binding": "DB_BACKUPS_KV"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "DEBATE_ROOMS",
						"class_name": "DebateRoomSignal"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1-debate-rooms",
					"new_sqlite_classes": [
						"DebateRoomSignal"
					]
				}
			],
			"d1_databases": [
				{
					"binding": "debate_db",
					"database_name": "debate-ai-db",
					"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
				}
			]
		}
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"d1_databases": [
		{
			"binding": "debate_db",
			"database_name": "debate-ai-db",
			"database_id": "fedaf7ca-66e8-4f8c-9650-53ef56aa5979"
		}
	]
}