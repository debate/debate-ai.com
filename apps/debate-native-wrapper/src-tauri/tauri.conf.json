{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Debate AI",
  "version": "1.0.0",
  "identifier": "com.debate.ai",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Debate AI",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Debate AI",
    "copyright": "Debate AI",
    "category": "Education",
    "shortDescription": "CARDS evidence search, FIAT round flowing, REASON writing, and LEARN video library, in one native app.",
    "longDescription": "CARDS evidence search, FIAT round flowing, REASON writing, and LEARN video library, in one native app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true,
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "debateai"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "debateai"
          ],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3RTU0M0VCRERCQjM3NDIKUldSQ043dmQ2MFBsQjMramMzMmpyT0VZbmJnN2htQkFmL3hkZkpEc0pxRzhRWHhKTmhvbGd6RnEK",
      "endpoints": [
        "https://github.com/debate/debate-ai.com/releases/download/native-wrapper-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
