{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline permissions for the wrapper's own (non-remote) window content and Rust side.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "opener:default",
    "opener:allow-open-url",
    "deep-link:default",
    "autostart:default",
    "allow-system-info",
    "allow-quick-launch"
  ]
}
