# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/
gen/

# Generated icon set (derived from the profile's iconSource by scripts/generate-icons.mjs)
src-tauri/icons/

# Mobile signing material — never commit keystores/certs/provisioning profiles
*.keystore
*.jks
*.p12
*.mobileprovision
*.p8

# OS junk
.DS_Store

# Offline source, built by `npm run build:offline` (scripts/build-offline.mjs)
dist/offline/

# Flatpak build output (scripts/build-flatpak.sh); the manifest + metainfo are generated and committed
flatpak/app.deb
flatpak/build-dir/
flatpak/repo/
flatpak/.flatpak-builder/
flatpak/*.flatpak
flatpak/*.flathub.yml

# Snap build output (scripts/build-snap.sh); snapcraft.yaml is generated and committed
snapcraft/app.deb
snapcraft/*.snap
snapcraft/parts/
snapcraft/stage/
snapcraft/prime/
