{
  "name": "@debate/native-wrapper",
  "version": "0.2.0",
  "description": "Generic Tauri wrapper that packages any website as a native desktop + mobile app, pre-configured to ship Debate AI",
  "private": true,
  "type": "module",
  "author": "vtempest",
  "license": "rights.institute/prosper",
  "scripts": {
    "tauri": "tauri",
    "configure": "node scripts/configure.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build:offline": "bun scripts/build-offline.mjs",
    "predev": "node scripts/configure.mjs",
    "dev": "tauri dev",
    "prebuild:desktop": "node scripts/configure.mjs",
    "build:desktop": "tauri build",
    "android:init": "tauri android init",
    "preandroid:dev": "node scripts/configure.mjs",
    "android:dev": "tauri android dev",
    "preandroid:build": "node scripts/configure.mjs",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "preios:dev": "node scripts/configure.mjs",
    "ios:dev": "tauri ios dev",
    "preios:build": "node scripts/configure.mjs",
    "ios:build": "tauri ios build",
    "docker:build:linux": "bash scripts/build-docker.sh --linux",
    "docker:build:windows": "bash scripts/build-docker.sh --windows",
    "docker:build:android": "bash scripts/build-docker.sh --android",
    "docker:build:ios-core": "bash scripts/build-docker.sh --ios-core",
    "docker:build:all": "bash scripts/build-docker.sh --all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  }
}
