{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "generate": {
      "inputs": [
        "debate-openapi.yml",
        "openapi-ts.config.ts",
        "package.json"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "@debate/api-client#build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@debate/editor#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "^build"
      ]
    },
    "@debate/api-client#typecheck": {
      "dependsOn": [
        "^typecheck",
        "^build",
        "generate"
      ]
    },
    "@debate/editor#typecheck": {
      "dependsOn": [
        "^typecheck",
        "^build",
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
