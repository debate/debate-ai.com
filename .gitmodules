[submodule "debate-editor"]
	path = packages/debate-editor-cm
	url = https://github.com/debate/debate-editor.git
	branch = main
	ignore = untracked

[submodule "debate-rankings"]
	path = packages/debate-rankings
	url = https://github.com/debate/debate-rankings.git
	branch = main


# `debate-flow-ebb` and `debate-tournaments-tabroom` used to be pinned here.
# Both were emptied out ("submodule being replaced") and those commits were
# never pushed, so a fresh `git submodule update --init` in CI died with
# `upload-pack: not our ref`. They are also redundant: the `debate-flow-ebb`
# package name now resolves to the in-tree `packages/debate-flow`, and Tabroom
# is vendored under `packages/debate-tournaments/vendor/tabroom`.
