[submodule "debate-editor"]
	path = packages/debate-editor-cm
	url = https://github.com/debate/debate-editor.git
	branch = main
	ignore = untracked

[submodule "debate-rankings"]
	path = packages/debate-rankings-sync-data
	url = https://github.com/debate/debate-rankings.git
	branch = main


# Upstream Tabroom. `packages/debate-tournaments/scripts/sync-upstream.mjs`
# patches it and copies the parts the app runs into
# `packages/debate-tournaments/vendor/tabroom-build/`; the app imports that.
[submodule "packages/debate-tournaments-tabroom"]
	path = packages/debate-tournaments-tabroom
	url = https://github.com/debate/debate-tournaments.git
	branch = main
